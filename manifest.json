{
  "manifest_version": 3,
  "name": "Bookmark Commander",
  "version": "0.1.0",
  "description": "A keyboard-first, two-pane browser for your bookmarks.",
  "permissions": ["bookmarks", "favicon"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Bookmark Commander",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": { "service_worker": "background.js" }
}
